#!/usr/bin/env ox

# A static blog generator using the ox 0.1 prelude and system utilities.
# Usage: ox build.ox BLOG_ROOT OUTPUT_DIRECTORY

val require = (condition, message) =>
  if condition then ()
  else
    do
      val _ = eprint message;
      exit 2
    end

val run = (args) =>
  do
    val result = Process.run args;
    if result.status == 0 then result
    else
      do
        val _ = eprint (S.join " " args);
        val _ = eprint result.stderr;
        exit result.status
      end
  end

val _ = require (L.length argv == 2, "usage: ox build.ox BLOG_ROOT OUTPUT_DIRECTORY")
val root = L.nth argv 0
val output = L.nth argv 1

val site = {
    title = "ox field notes"
  , author = "ox contributors"
  , origin = "https://example.org"
  , description = "A small static blog built with ox and Unix utilities."
}

val replace = (before, after, source) => S.join after (S.split before source)

val escape = (value) =>
  do
    val a = replace ("&", "&amp;", value);
    val b = replace ("<", "&lt;", a);
    val c = replace (">", "&gt;", b);
    replace ("\"", "&quot;", c)
  end

val safe_char = (char) =>
  (char >= "a" andalso char <= "z") orelse
  (char >= "0" andalso char <= "9") orelse
  char == "-"

val safe_slug = rec (value, offset) =>
  if offset == S.length value then true
  else
    do
      val char = S.sub value offset 1;
      if safe_char char then safe_slug (value, offset + 1)
      else false
    end

val read_field = (name, line) =>
  do
    val parts = S.split ": " line;
    val _ = require (L.hd parts == name andalso L.length parts > 1,
      "expected metadata field: " ^ name);
    S.join ": " (L.tl parts)
  end

val read_post = (source) =>
  do
    val text = U.read source;
    val lines = S.lines text;
    val _ = require (L.length lines >= 6, "short post: " ^ source);
    val _ = require (L.nth lines 0 == "---" andalso L.nth lines 5 == "---",
      "expected six-line YAML front matter: " ^ source);
    val title = read_field ("title", L.nth lines 1);
    val date = read_field ("date", L.nth lines 2);
    val description = read_field ("description", L.nth lines 3);
    val tags = S.split ", " (read_field ("tags", L.nth lines 4));
    val filename = Path.basename source;
    val slug = S.sub filename 0 (S.length filename - 3);
    val _ = require (S.length slug > 0 andalso safe_slug (slug, 0),
      "unsafe post slug: " ^ filename);
    val _ = require (S.length date == 10, "date must be YYYY-MM-DD: " ^ source);
    val validate_tag = (tag) => require
      (S.length tag > 0 andalso safe_slug (tag, 0), "unsafe tag: " ^ tag);
    val _ = L.app validate_tag tags;

    { source
    , slug
    , title
    , date
    , description
    , tags
    }
  end

val post_url = (post) => site.origin ^ "/posts/" ^ post.slug ^ ".html"
val tag_url = (tag) => "/tags/" ^ tag ^ ".html"

val layout = (title, description, body) =>
  S.join "\n" [
    "<!doctype html>"
  , "<html lang=\"en\">"
  , "<head>"
  , "<meta charset=\"utf-8\">"
  , "<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">"
  , "<meta name=\"description\" content=\"" ^ escape description ^ "\">"
  , "<title>" ^ escape title ^ " · " ^ escape site.title ^ "</title>"
  , "<link rel=\"stylesheet\" href=\"/style.css\">"
  , "<link rel=\"alternate\" type=\"application/atom+xml\" href=\"/atom.xml\">"
  , "</head>"
  , "<body>"
  , "<header class=\"site-header\"><a class=\"brand\" href=\"/\">" ^ escape site.title ^ "</a>"
  , "<nav><a href=\"/archive.html\">archive</a><a href=\"/about.html\">about</a><a href=\"/atom.xml\">feed</a></nav></header>"
  , "<main>"
  , body
  , "</main>"
  , "<footer>© " ^ escape site.author ^ " · generated by ox</footer>"
  , "</body></html>"
  ]

val tag_link = (tag) =>
  "<a class=\"tag\" href=\"" ^ tag_url tag ^ "\">#" ^ escape tag ^ "</a>"

val tag_links = (tags) => S.join " " (L.map tag_link tags)

val listing = (post) =>
  S.join "\n" [
    "<li class=\"post\">"
  , "<time datetime=\"" ^ escape post.date ^ "\">" ^ escape post.date ^ "</time>"
  , "<h2><a href=\"/posts/" ^ post.slug ^ ".html\">" ^ escape post.title ^ "</a></h2>"
  , "<p>" ^ escape post.description ^ "</p>"
  , "<div class=\"tags\">" ^ tag_links post.tags ^ "</div>"
  , "</li>"
  ]

val post_list = (posts) =>
  "<ul class=\"posts\">\n" ^ S.join "\n" (L.map listing posts) ^ "\n</ul>"

val take = rec (n, xs) =>
  if n <= 0 then []
  else
    case xs of
        [] => []
      | first :: rest => first :: take (n - 1, rest)

val has = rec (needle, xs) =>
  case xs of
      [] => false
    | first :: rest => if needle == first then true else has (needle, rest)

val add_unique = (tag, tags) =>
  if has (tag, tags) then tags
  else tags @ [tag]

val gather_tags = (post, tags) => L.foldl add_unique tags post.tags

val write_post = (post) =>
  do
    val converted = run ["pandoc", "--from=markdown+yaml_metadata_block",
      "--to=html5", "--wrap=none", post.source];
    val article = S.join "\n" [
      "<article>"
    , "<h1>" ^ escape post.title ^ "</h1>"
    , "<p class=\"meta\"><time datetime=\"" ^ escape post.date ^ "\">" ^ escape post.date ^ "</time></p>"
    , "<div class=\"tags\">" ^ tag_links post.tags ^ "</div>"
    , converted.stdout
    , "</article>"
    ];
    val html = layout (post.title, post.description, article);
    val target = output ^ "/posts/" ^ post.slug ^ ".html";
    val _ = U.write target html;
    P.printf "wrote %s\n" target
  end

val atom_entry = (post) =>
  S.join "\n" [
    "<entry>"
  , "<title>" ^ escape post.title ^ "</title>"
  , "<id>" ^ escape (post_url post) ^ "</id>"
  , "<link href=\"" ^ escape (post_url post) ^ "\"/>"
  , "<updated>" ^ escape post.date ^ "T00:00:00Z</updated>"
  , "<summary>" ^ escape post.description ^ "</summary>"
  , "</entry>"
  ]

val sitemap_url = (url, date) =>
  "<url><loc>" ^ escape url ^ "</loc><lastmod>" ^ escape date ^ "</lastmod></url>"

val sitemap_post = (post) => sitemap_url (post_url post, post.date)

val _ = run ["mkdir", "-p", output ^ "/posts", output ^ "/tags"]
val _ = run ["cp", root ^ "/assets/style.css", output ^ "/style.css"]

# Path.glob sorts lexicographically. ISO-date filenames put newer posts last.
val posts = L.rev (L.map read_post (Path.glob (root ^ "/posts/*.md")))
val tags = L.foldl gather_tags [] posts
val last_date = if L.length posts == 0 then "1970-01-01" else (L.hd posts).date

val _ = L.app write_post posts

val home = S.join "\n" [
  "<h1>" ^ escape site.title ^ "</h1>"
, "<p class=\"intro\">" ^ escape site.description ^ "</p>"
, "<h2>Recent writing</h2>"
, post_list (take (5, posts))
, "<p><a href=\"/archive.html\">All posts →</a></p>"
]
val _ = U.write (output ^ "/index.html") (layout (site.title, site.description, home))
val _ = U.write (output ^ "/archive.html")
  (layout ("Archive", "All articles", "<h1>Archive</h1>" ^ post_list posts))

val write_tag = (tag) =>
  do
    val belongs = (post) => has (tag, post.tags);
    val matching = L.filter belongs posts;
    val html = layout ("#" ^ tag, "Articles tagged " ^ tag,
      "<h1>#" ^ escape tag ^ "</h1>" ^ post_list matching);
    U.write (output ^ tag_url tag) html
  end

val _ = L.app write_tag tags

val about = run ["pandoc", "--from=markdown", "--to=html5", "--wrap=none", root ^ "/about.md"]
val _ = U.write (output ^ "/about.html")
  (layout ("About", "About this blog", "<article>" ^ about.stdout ^ "</article>"))

val feed = S.join "\n" [
  "<?xml version=\"1.0\" encoding=\"utf-8\"?>"
, "<feed xmlns=\"http://www.w3.org/2005/Atom\">"
, "<title>" ^ escape site.title ^ "</title>"
, "<id>" ^ escape site.origin ^ "/</id>"
, "<link href=\"" ^ escape site.origin ^ "/\"/>"
, "<link rel=\"self\" href=\"" ^ escape site.origin ^ "/atom.xml\"/>"
, "<author><name>" ^ escape site.author ^ "</name></author>"
, "<updated>" ^ last_date ^ "T00:00:00Z</updated>"
, S.join "\n" (L.map atom_entry posts)
, "</feed>"
]
val _ = U.write (output ^ "/atom.xml") feed

val sitemap_tag = (tag) =>
  sitemap_url (site.origin ^ tag_url tag, last_date)

val sitemap = S.join "\n" [
  "<?xml version=\"1.0\" encoding=\"utf-8\"?>"
, "<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\">"
, sitemap_url (site.origin ^ "/", last_date)
, sitemap_url (site.origin ^ "/archive.html", last_date)
, sitemap_url (site.origin ^ "/about.html", last_date)
, S.join "\n" (L.map sitemap_post posts)
, S.join "\n" (L.map sitemap_tag tags)
, "</urlset>"
]
val _ = U.write (output ^ "/sitemap.xml") sitemap
val _ = U.write (output ^ "/robots.txt")
  ("User-agent: *\nAllow: /\nSitemap: " ^ site.origin ^ "/sitemap.xml\n")
val _ = U.write (output ^ "/404.html")
  (layout ("Not found", "Page not found", "<h1>404</h1><p>This page does not exist.</p>"))
val _ = P.printf "built %d posts and %d tag pages in %s\n"
  (L.length posts) (L.length tags) output
